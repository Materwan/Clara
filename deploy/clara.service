# Install:
#   sudo cp deploy/clara.service /etc/systemd/system/clara.service
#   (edit User and the paths below)
#   sudo systemctl daemon-reload && sudo systemctl enable --now clara
# Logs: journalctl -u clara -f
# With CLARA_TAILSCALE: sudo tailscale set --operator=clara   (lets the service user drive tailscale)
[Unit]
Description=Clara AI server
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=clara
WorkingDirectory=/opt/clara
# Holds CLARA_TOKENS, CLARA_LOCAL_MODEL / CLARA_CLOUD_MODEL, OLLAMA_API_KEY, CLARA_DATA_DIR...
# (see .env.example)
EnvironmentFile=/opt/clara/.env
ExecStart=/opt/clara/.venv/bin/clara-server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
