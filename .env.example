# Generate any token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Chat clients (terminal, Discord, apps): "name:token" pairs, comma separated.
# One token per client so each can be revoked on its own. Required.
CLARA_TOKENS=terminal:change-me,discord:change-me-too

# Which surfaces each client may speak for: "client=surface|surface" pairs. A client listed here
# can only read and write the people, facts and conversations of those surfaces (a conversation id
# must start with "<surface>:"). A client with no entry may use any surface, and the server warns.
# CLARA_CLIENT_SURFACES=terminal=cli|console,discord=discord

# Operators: tokens for the remote console (`clara-admin`). They are NOT chat tokens
# (and cannot be the same value). Leave empty to disable remote admin entirely.
CLARA_ADMIN_TOKENS=ops:change-me-as-well

# --- Language model providers ------------------------------------------------
# Which one is used at first start; /provider in the console switches it live
# and the choice is remembered in the data dir. local | cloud
CLARA_PROVIDER=local

# "local" = Local host: Ollama on this machine (or any host)
# OLLAMA_HOST=http://localhost:11434
CLARA_LOCAL_MODEL=gemma4:31b-cloud

# "cloud" = Ollama API key: ollama.com, authenticated with your key
# (create one at https://ollama.com/settings/keys). Never leaves this file.
# OLLAMA_API_KEY=
CLARA_CLOUD_MODEL=gpt-oss:120b

# --- Network and storage -----------------------------------------------------
# Keep 127.0.0.1 unless the server sits behind a VPN / reverse proxy.
CLARA_HOST=127.0.0.1
CLARA_PORT=8765
CLARA_DATA_DIR=data

# Context window of each provider, in tokens. The percentages clients show, and the moment a
# conversation is compacted, are relative to it. "local" also asks Ollama for exactly that window
# (Ollama's own default is tiny).
# CLARA_LOCAL_CONTEXT_WINDOW=32768
# CLARA_CLOUD_CONTEXT_WINDOW=131072
# Summarise a conversation when its context is this full, in percent (0 = never)
# CLARA_COMPACT_PERCENT=80
# Turns at the end of a conversation that a compaction leaves as they are (0 = summarise everything)
# CLARA_KEEP_RECENT_TURNS=2

# Optional tuning
# Turns of a conversation (a message and everything that followed it) the model gets back
# CLARA_HISTORY_TURNS=20
# Model rounds one turn may take (a round = one model call, possibly asking for tools)
# CLARA_MAX_TOOL_ROUNDS=40
# Seconds a client may take to run its tools and answer (it may ask its user first)
# CLARA_TOOL_TIMEOUT=900
# CLARA_MAX_CONCURRENT_LLM=2
# Tokens of remembered facts shown to the model in each prompt (the newest first; the model can
# find the others with its recall_facts tool)
# CLARA_FACTS_TOKEN_BUDGET=2000
# Seconds the model may take to start answering (thinking models are slow), then the longest
# pause it may make between two pieces of its answer. A model that hangs is given up on.
# CLARA_LLM_FIRST_TOKEN_TIMEOUT=300
# CLARA_LLM_IDLE_TIMEOUT=120
# CLARA_SYSTEM_PROMPT_FILE=config/system_prompt.md
